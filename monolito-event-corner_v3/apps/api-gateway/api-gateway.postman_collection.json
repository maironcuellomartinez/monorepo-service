{
  "info": {
    "name": "api-gateway (event-corner)",
    "description": "Endpoints del api-gateway del ecosistema Event Corner. Puerto: dev :4000, staging/prod :3000. Swagger en /docs.\n\nAUTH: guard global JwtGuard (verifica token de usuario Entra ID Y token M2M EdDSA localmente) + RolesGuard + AbacGuard. Casi todo requiere Bearer {{token}}.\n- Rutas @Public: /health/live, /health/ready, /api/auth/dev/login.\n- Endpoints de usuario (/api/*): usan token de usuario. En dev, obtenelo con POST /api/auth/dev/login y pegalo en {{token}}.\n- Endpoints /outbound/* e /internal-api/*: los llama el micorner/otros servicios con token M2M EdDSA. Para probarlos manualmente pegá un {{m2m_token}} en {{token}}.\n\nVariables: {{base_url}} (default http://localhost:4000), {{token}}, {{m2m_token}}, e ids de ejemplo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [
    { "key": "base_url", "value": "http://localhost:4000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "m2m_token", "value": "", "type": "string" },
    { "key": "id", "value": "REPLACE_WITH_UUID", "type": "string" },
    { "key": "cornerId", "value": "REPLACE_WITH_CORNER_ID", "type": "string" },
    { "key": "userId", "value": "REPLACE_WITH_USER_ID", "type": "string" },
    { "key": "technicianId", "value": "REPLACE_WITH_TECH_ID", "type": "string" },
    { "key": "deviceId", "value": "REPLACE_WITH_DEVICE_ID", "type": "string" },
    { "key": "scheduleId", "value": "REPLACE_WITH_SCHEDULE_ID", "type": "string" },
    { "key": "sysId", "value": "REPLACE_WITH_SN_SYS_ID", "type": "string" },
    { "key": "correlationId", "value": "REPLACE_WITH_CORRELATION_ID", "type": "string" },
    { "key": "serialNumber", "value": "REPLACE_WITH_SERIAL", "type": "string" },
    { "key": "number", "value": "INC0001234", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Live (público)", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": { "raw": "{{base_url}}/health/live", "host": ["{{base_url}}"], "path": ["health", "live"] } } },
        { "name": "Ready (público)", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": { "raw": "{{base_url}}/health/ready", "host": ["{{base_url}}"], "path": ["health", "ready"] } } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Dev login (público, DEV ONLY)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"empleado1@eventcorner.com\",\n  \"oid\": \"dev-user-001\",\n  \"name\": \"Juan Pérez\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/dev/login", "host": ["{{base_url}}"], "path": ["api", "auth", "dev", "login"] },
            "description": "Genera token dev:<base64> y lo valida contra ABAC. Copiá accessToken de la respuesta a {{token}}."
          }
        },
        { "name": "Me", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] } } }
      ]
    },
    {
      "name": "ABAC",
      "item": [
        {
          "name": "Batch evaluate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"evaluations\": [\n    { \"resource\": \"incident\", \"action\": \"create\" },\n    { \"resource\": \"corner\", \"action\": \"list\" }\n  ]\n}" },
            "url": { "raw": "{{base_url}}/api/abac/batch-evaluate", "host": ["{{base_url}}"], "path": ["api", "abac", "batch-evaluate"] }
          }
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        { "name": "List users (picker)", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/incidents/users", "host": ["{{base_url}}"], "path": ["api", "incidents", "users"] } } },
        { "name": "Search users", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/incidents/users/search?q=empleado", "host": ["{{base_url}}"], "path": ["api", "incidents", "users", "search"], "query": [{ "key": "q", "value": "empleado" }] } } },
        { "name": "List incidents", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/incidents?page=1&limit=20", "host": ["{{base_url}}"], "path": ["api", "incidents"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }, { "key": "email", "value": "", "disabled": true }, { "key": "serial", "value": "", "disabled": true }, { "key": "snNumber", "value": "", "disabled": true }] } } },
        { "name": "Mine", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/incidents/mine", "host": ["{{base_url}}"], "path": ["api", "incidents", "mine"] } } },
        { "name": "Available", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/incidents/available", "host": ["{{base_url}}"], "path": ["api", "incidents", "available"] } } },
        { "name": "By technician", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/incidents/technician/{{technicianId}}", "host": ["{{base_url}}"], "path": ["api", "incidents", "technician", "{{technicianId}}"] } } },
        { "name": "Get by id", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/incidents/{{id}}", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}"] } } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"{{userId}}\",\n  \"cornerId\": \"{{cornerId}}\",\n  \"issueTypeId\": \"REPLACE_WITH_ISSUE_TYPE_ID\",\n  \"deviceSerial\": \"{{serialNumber}}\",\n  \"scheduledRange\": { \"start\": \"2026-07-25T10:00:00.000Z\", \"end\": \"2026-07-25T10:30:00.000Z\" },\n  \"slotIds\": [\"REPLACE_WITH_SLOT_ID\"],\n  \"description\": \"Incidencia de prueba\"\n}" }, "url": { "raw": "{{base_url}}/api/incidents", "host": ["{{base_url}}"], "path": ["api", "incidents"] } } },
        { "name": "Deliver", "request": { "method": "PATCH", "header": [], "url": { "raw": "{{base_url}}/api/incidents/{{id}}/deliver", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "deliver"] } } },
        { "name": "Take", "request": { "method": "PATCH", "header": [], "url": { "raw": "{{base_url}}/api/incidents/{{id}}/take", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "take"] } } },
        { "name": "Release", "request": { "method": "PATCH", "header": [], "url": { "raw": "{{base_url}}/api/incidents/{{id}}/release", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "release"] } } },
        { "name": "Change status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}" }, "url": { "raw": "{{base_url}}/api/incidents/{{id}}/status", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "status"] } } },
        { "name": "Cancel", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Cancelada por el cliente\"\n}" }, "url": { "raw": "{{base_url}}/api/incidents/{{id}}/cancel", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "cancel"] } } },
        { "name": "Validate", "request": { "method": "PATCH", "header": [], "url": { "raw": "{{base_url}}/api/incidents/{{id}}/validate", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "validate"] } } },
        { "name": "Reopen", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Reapertura por recurrencia\"\n}" }, "url": { "raw": "{{base_url}}/api/incidents/{{id}}/reopen", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "reopen"] } } },
        { "name": "Timeline", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/incidents/{{id}}/timeline", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "timeline"] } } },
        { "name": "Add note", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"note\": \"Nota de seguimiento\"\n}" }, "url": { "raw": "{{base_url}}/api/incidents/{{id}}/notes", "host": ["{{base_url}}"], "path": ["api", "incidents", "{{id}}", "notes"] } } }
      ]
    },
    {
      "name": "Requests",
      "item": [
