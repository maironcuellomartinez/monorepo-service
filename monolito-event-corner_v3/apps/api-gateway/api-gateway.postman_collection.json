        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"companyId\": \"REPLACE_WITH_COMPANY_ID\",\n  \"userId\": \"{{userId}}\",\n  \"cornerId\": \"{{cornerId}}\",\n  \"issueTypeId\": \"REPLACE_WITH_ISSUE_TYPE_ID\",\n  \"description\": \"Request de prueba\"\n}" }, "url": { "raw": "{{base_url}}/api/requests", "host": ["{{base_url}}"], "path": ["api", "requests"] } } },
        { "name": "Change status", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}" }, "url": { "raw": "{{base_url}}/api/requests/{{id}}/status", "host": ["{{base_url}}"], "path": ["api", "requests", "{{id}}", "status"] } } }
