        { "name": "Technicians by corner", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/availability/{{cornerId}}/technicians?date=2026-07-25", "host": ["{{base_url}}"], "path": ["api", "availability", "{{cornerId}}", "technicians"], "query": [{ "key": "date", "value": "2026-07-25" }] } } }
