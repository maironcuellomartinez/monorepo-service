{
  "name": "monolito-event-corner_v3",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:api-gateway": "nest build api-gateway",
    "build:micorner": "nest build micorner",
    "build:all": "npm run build:api-gateway && npm run build:micorner",
    "start:api-gateway:dev": "nest start api-gateway --watch",
    "start:api-gateway:debug": "nest start api-gateway --debug --watch",
    "start:micorner:dev": "nest start micorner --watch",
    "start:micorner:debug": "nest start micorner --debug --watch",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:staging": "pm2 start ecosystem.config.js --env staging",
    "pm2:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:reload:dev": "npm run build:all && pm2 reload ecosystem.config.js --env development",
    "pm2:reload:staging": "npm run build:all && pm2 reload ecosystem.config.js --env staging",
    "pm2:reload:prod": "npm run build:all && pm2 reload ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:save": "pm2 save",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "micorner:seed": "ts-node -r tsconfig-paths/register apps/micorner/src/scripts/seed-test-data.ts",
    "micorner:wipe": "ts-node -r tsconfig-paths/register apps/micorner/src/scripts/wipe-data.ts",
    "format": "prettier --write \"src/**/*.ts\" \"apps/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@backendkit-labs/bulkhead": "^0.2.1",
    "@backendkit-labs/circuit-breaker": "^0.3.1",
    "@backendkit-labs/http-client": "^0.2.1",
    "@backendkit-labs/retry": "^0.1.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cache-manager": "^7.2.0",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "json-rules-engine": "^7.3.1",
    "jwks-rsa": "^3.2.2",
    "mysql2": "^3.19.0",
    "node-cache": "^5.1.2",
    "passport": "^0.7.0",
    "passport-headerapikey": "^1.2.2",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.28",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "webpack": "^5.105.4",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps",
      "<rootDir>/libs"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "moduleNameMapper": {
      "^@app/core(|/.*)$": "<rootDir>/apps/micorner/src/core/$1",
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1",
      "^@app/observability(|/.*)$": "<rootDir>/libs/observability/$1",
      "^@app/date(|/.*)$": "<rootDir>/libs/date-utils/src/$1",
      "^@app/ed25519(|/.*)$": "<rootDir>/libs/ed25519.service/src/$1",
      "^@app/result(|/.*)$": "<rootDir>/libs/result/src/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
