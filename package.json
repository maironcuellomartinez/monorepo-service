{
  "name": "workspace-santander",
  "private": true,
  "scripts": {
    "sim:gateway": "node simulators/gateway-simulator.js",
    "sim:snow": "node simulators/snow-request-simulator.js",
    "sim:thruk": "node simulators/thruk-simulator.js",
    "sim:combined": "node simulators/combined-simulator.js",

    "sim:incident": "node simulators/snow-request-simulator.js queue --type incident",
    "sim:incident:immediate": "node simulators/snow-request-simulator.js immediate --type incident --severity critical",
    "sim:dlq": "node simulators/snow-request-simulator.js failed",
    "sim:retry-all": "node simulators/snow-request-simulator.js retry-all",

    "sim:storm": "node simulators/thruk-simulator.js scenario --name storm",
    "sim:recovery": "node simulators/thruk-simulator.js scenario --name recovery",
    "sim:dedup": "node simulators/thruk-simulator.js scenario --name dedup",

    "sim:full-lifecycle": "node simulators/combined-simulator.js scenario --name full-lifecycle",
    "sim:cascade": "node simulators/combined-simulator.js scenario --name cascade-failure",
    "sim:parallel": "node simulators/combined-simulator.js scenario --name parallel-storm",

    "sim:list": "node simulators/combined-simulator.js list"
  }
}
