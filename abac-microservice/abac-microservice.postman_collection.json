        { "name": "List policy permissions", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/policies/{{policyId}}/permissions", "host": ["{{base_url}}"], "path": ["policies", "{{policyId}}", "permissions"] } } },
