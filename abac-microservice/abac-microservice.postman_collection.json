      "name": "Policies (Bearer admin)",
      "item": [
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Política de horario\",\n  \"effect\": \"allow\",\n  \"priority\": 10,\n  \"applicationId\": \"{{applicationId}}\",\n  \"conditions\": {}\n}" }, "url": { "raw": "{{base_url}}/policies", "host": ["{{base_url}}"], "path": ["policies"] } } },
        { "name": "List", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/policies", "host": ["{{base_url}}"], "path": ["policies"] } } },
        { "name": "Get by id", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/policies/{{policyId}}", "host": ["{{base_url}}"], "path": ["policies", "{{policyId}}"] } } },
        { "name": "Update", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"priority\": 20\n}" }, "url": { "raw": "{{base_url}}/policies/{{policyId}}", "host": ["{{base_url}}"], "path": ["policies", "{{policyId}}"] } } },
