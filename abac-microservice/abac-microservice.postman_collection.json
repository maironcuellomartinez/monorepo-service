{
  "info": {
    "name": "abac-microservice",
    "description": "Endpoints del abac-microservice (motor ABAC + multi-auth). Puerto :3005. Swagger en /api-docs.\n\nTRES modelos de auth conviven:\n1. ApiKeyGuard → header 'x-api-key: {{api_key}}' (a veces + 'api-secret'). Usado en /abac/* y varios /auth/validate-*.\n2. JwtAuthGuard + RolesGuard → Bearer {{admin_token}} (JWT admin de POST /auth/admin/login). Usado en /applications, /audit, /permissions, /policies, /roles, /users.\n3. Públicas → /auth/admin/login, /auth/service-token, /auth/oauth/token, /auth/dev/simulate-entra, /auth/.well-known/jwks.json, /user-policies.\n\nFlujo típico: POST /auth/admin/login → copiar token a {{admin_token}}. Para M2M: POST /auth/service-token (apiKey+apiSecret) o /auth/oauth/token (client_credentials).\n\nVariables: {{base_url}} (http://localhost:3005), {{admin_token}}, {{api_key}}, {{api_secret}}, {{applicationId}}, ids de ejemplo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }] },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3005", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "api_key", "value": "", "type": "string" },
    { "key": "api_secret", "value": "", "type": "string" },
    { "key": "applicationId", "value": "REPLACE_WITH_APP_ID", "type": "string" },
    { "key": "userId", "value": "REPLACE_WITH_USER_ID", "type": "string" },
    { "key": "roleId", "value": "REPLACE_WITH_ROLE_ID", "type": "string" },
    { "key": "permissionId", "value": "REPLACE_WITH_PERMISSION_ID", "type": "string" },
    { "key": "policyId", "value": "REPLACE_WITH_POLICY_ID", "type": "string" },
    { "key": "ruleId", "value": "REPLACE_WITH_RULE_ID", "type": "string" },
    { "key": "id", "value": "REPLACE_WITH_ID", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth (públicas + ApiKey)",
      "item": [
        { "name": "Admin login (público)", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@eventcorner.com\",\n  \"password\": \"REPLACE_WITH_PASSWORD\",\n  \"applicationId\": \"{{applicationId}}\"\n}" }, "url": { "raw": "{{base_url}}/auth/admin/login", "host": ["{{base_url}}"], "path": ["auth", "admin", "login"] }, "description": "Devuelve JWT admin. Copiá 'token' a {{admin_token}}." } },
        { "name": "Service token (M2M, público)", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"apiKey\": \"{{api_key}}\",\n  \"apiSecret\": \"{{api_secret}}\"\n}" }, "url": { "raw": "{{base_url}}/auth/service-token", "host": ["{{base_url}}"], "path": ["auth", "service-token"] }, "description": "Intercambia apiKey+apiSecret por JWT (1h)." } },
        { "name": "OAuth token (client_credentials, público)", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"client_id\": \"ak_...\",\n  \"client_secret\": \"sec_...\",\n  \"scope\": \"incident:create corner:list\"\n}" }, "url": { "raw": "{{base_url}}/auth/oauth/token", "host": ["{{base_url}}"], "path": ["auth", "oauth", "token"] } } },
        { "name": "Validate api-key (ApiKey)", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "x-api-key", "value": "{{api_key}}" }], "url": { "raw": "{{base_url}}/auth/validate-api-key", "host": ["{{base_url}}"], "path": ["auth", "validate-api-key"] } } },
        { "name": "Validate token (ApiKey)", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "x-api-key", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"REPLACE_WITH_JWT_TO_VALIDATE\"\n}" }, "url": { "raw": "{{base_url}}/auth/validate-token", "host": ["{{base_url}}"], "path": ["auth", "validate-token"] } } },
        { "name": "Validate Entra (ApiKey)", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "x-api-key", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"token\": \"REPLACE_WITH_ENTRA_JWT\",\n  \"applicationId\": \"{{applicationId}}\"\n}" }, "url": { "raw": "{{base_url}}/auth/validate-entra", "host": ["{{base_url}}"], "path": ["auth", "validate-entra"] } } },
        { "name": "Dev simulate Entra (público)", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"empleado1@eventcorner.com\",\n  \"applicationId\": \"{{applicationId}}\"\n}" }, "url": { "raw": "{{base_url}}/auth/dev/simulate-entra", "host": ["{{base_url}}"], "path": ["auth", "dev", "simulate-entra"] } } },
        { "name": "Admin keypair (Bearer admin)", "request": { "method": "POST", "header": [], "url": { "raw": "{{base_url}}/auth/admin/keypair", "host": ["{{base_url}}"], "path": ["auth", "admin", "keypair"] } } },
        { "name": "JWKS (.well-known, público)", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": { "raw": "{{base_url}}/auth/.well-known/jwks.json", "host": ["{{base_url}}"], "path": ["auth", ".well-known", "jwks.json"] } } }
      ]
    },
    {
      "name": "ABAC (ApiKey — x-api-key)",
      "item": [
        { "name": "Can access", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "x-api-key", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"applicationId\": \"{{applicationId}}\",\n  \"resource\": \"incident\",\n  \"action\": \"create\",\n  \"context\": {}\n}" }, "url": { "raw": "{{base_url}}/abac/can-access", "host": ["{{base_url}}"], "path": ["abac", "can-access"] } } },
        { "name": "User roles", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [{ "key": "x-api-key", "value": "{{api_key}}" }], "url": { "raw": "{{base_url}}/abac/user-roles?userId={{userId}}&applicationId={{applicationId}}", "host": ["{{base_url}}"], "path": ["abac", "user-roles"], "query": [{ "key": "userId", "value": "{{userId}}" }, { "key": "applicationId", "value": "{{applicationId}}" }] } } },
        { "name": "Batch evaluate", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "x-api-key", "value": "{{api_key}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"applicationId\": \"{{applicationId}}\",\n  \"evaluations\": [\n    { \"resource\": \"incident\", \"action\": \"create\" },\n    { \"resource\": \"corner\", \"action\": \"list\" }\n  ]\n}" }, "url": { "raw": "{{base_url}}/abac/batch-evaluate", "host": ["{{base_url}}"], "path": ["abac", "batch-evaluate"] } } }
      ]
    },
    {
      "name": "Applications (Bearer admin)",
      "item": [
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mi aplicación\",\n  \"type\": \"internal\",\n  \"ownerUserId\": \"{{userId}}\"\n}" }, "url": { "raw": "{{base_url}}/applications", "host": ["{{base_url}}"], "path": ["applications"] } } },
        { "name": "List", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/applications", "host": ["{{base_url}}"], "path": ["applications"] } } },
        { "name": "Get by id", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/applications/{{applicationId}}", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}"] } } },
        { "name": "Update", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nombre actualizado\"\n}" }, "url": { "raw": "{{base_url}}/applications/{{applicationId}}", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}"] } } },
        { "name": "Reactivate", "request": { "method": "POST", "header": [], "url": { "raw": "{{base_url}}/applications/{{applicationId}}/reactivate", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}", "reactivate"] } } },
        { "name": "Delete", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{base_url}}/applications/{{applicationId}}", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}"] } } },
        { "name": "Delete permanent", "request": { "method": "DELETE", "header": [], "url": { "raw": "{{base_url}}/applications/{{applicationId}}/permanent", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}", "permanent"] } } },
        { "name": "Regenerate api-key", "request": { "method": "POST", "header": [], "url": { "raw": "{{base_url}}/applications/{{applicationId}}/regenerate-api-key", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}", "regenerate-api-key"] } } },
        { "name": "Validate api-key", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"apiKey\": \"{{api_key}}\"\n}" }, "url": { "raw": "{{base_url}}/applications/validate-api-key", "host": ["{{base_url}}"], "path": ["applications", "validate-api-key"] } } },
        { "name": "Create M2M service", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"monolith\",\n  \"tokenDurationDays\": 365\n}" }, "url": { "raw": "{{base_url}}/applications/m2m-service", "host": ["{{base_url}}"], "path": ["applications", "m2m-service"] } } },
        { "name": "Issue token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"tokenDurationDays\": 365\n}" }, "url": { "raw": "{{base_url}}/applications/{{applicationId}}/issue-token", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}", "issue-token"] } } },
        { "name": "Create OAuth client", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"OAuth client externo\",\n  \"ownerUserId\": \"{{userId}}\",\n  \"scopes\": [\"incident:create\", \"corner:list\"]\n}" }, "url": { "raw": "{{base_url}}/applications/oauth", "host": ["{{base_url}}"], "path": ["applications", "oauth"] } } },
        { "name": "Update scopes", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"scopes\": [\"incident:create\", \"incident:list\"]\n}" }, "url": { "raw": "{{base_url}}/applications/{{applicationId}}/scopes", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}", "scopes"] } } },
        { "name": "Rotate secret", "request": { "method": "POST", "header": [], "url": { "raw": "{{base_url}}/applications/{{applicationId}}/rotate-secret", "host": ["{{base_url}}"], "path": ["applications", "{{applicationId}}", "rotate-secret"] } } }
      ]
    },
