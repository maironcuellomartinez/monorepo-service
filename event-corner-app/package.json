{
  "name": "event-corner-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc -b && vite build",
    "build:staging": "tsc -b && vite build --mode staging",
    "build:prod": "tsc -b && vite build --mode production",
    "preview": "vite preview",
    "pm2:dev": "npm run build && pm2 start ecosystem.config.cjs --env development",
    "pm2:staging": "npm run build:staging && pm2 start ecosystem.config.cjs --env staging",
    "pm2:prod": "npm run build:prod && pm2 start ecosystem.config.cjs --env production",
    "pm2:reload:dev": "npm run build && pm2 reload ecosystem.config.cjs --env development",
    "pm2:reload:staging": "npm run build:staging && pm2 reload ecosystem.config.cjs --env staging",
    "pm2:reload:prod": "npm run build:prod && pm2 reload ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop event-corner-app",
    "pm2:delete": "pm2 delete event-corner-app",
    "pm2:logs": "pm2 logs event-corner-app",
    "pm2:status": "pm2 status event-corner-app"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.29.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^25.5.2",
    "@types/react": "^19.0.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "tailwindcss": "^4.0.9",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
